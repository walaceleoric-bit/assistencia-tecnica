@model AssistenciaTecnica.Models.Cliente

@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="container mt-4">
    <a class="back-button"
           asp-controller="Clientes"
           asp-action="Index">
        ← Voltar
    </a>
</div>

<form asp-action="Criar"
      method="post"
      class="form-card">

    <h2>Novo Cliente</h2>

    <div class="alert alert-info mt-3 mb-4">
        <strong>ℹ️ Cadastro do cliente:</strong><br />
        Preencha os dados do cliente e defina um <strong>usuário</strong> e uma <strong>senha</strong>
        para ele acompanhar os próprios serviços futuramente.
    </div>

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Erro"]
        </div>
    }

    <h4 class="mt-4">Dados pessoais</h4>

    <label>Nome</label>
    <input asp-for="Nome"
           class="form-control" />

    <span asp-validation-for="Nome"
          class="text-danger"></span>

    <label>CPF</label>
    <input asp-for="Cpf"
           id="cpf"
           class="form-control"
           maxlength="14"
           inputmode="numeric"
           placeholder="000.000.000-00" />

    <span asp-validation-for="Cpf"
          class="text-danger"></span>

    <label>Telefone</label>
    <input asp-for="Telefone"
           class="form-control"
           inputmode="numeric"
           placeholder="Ex: 27999999999" />

    <label>Email</label>
    <input asp-for="Email"
           class="form-control" />

    <label>Endereço</label>
    <input asp-for="Endereco"
           class="form-control" />

    <label>Cidade</label>
    <input asp-for="Cidade"
           class="form-control" />

    <h4 class="mt-4">Acesso do cliente</h4>

    <label>Usuário do cliente</label>
    <input asp-for="UsuarioCliente"
           class="form-control"
           placeholder="Ex: izaque123" />

    <label>Senha do cliente</label>
    <input asp-for="SenhaCliente"
           class="form-control"
           placeholder="Ex: 123456" />

    <label>Observação</label>
    <textarea asp-for="Observacao"
              rows="4"
              class="form-control"></textarea>

    <button type="submit"
            class="btn-main mt-3">
        Salvar
    </button>

</form>

<script>
    const cpfInput = document.getElementById("cpf");

    cpfInput.addEventListener("input", function () {
        let valor = cpfInput.value.replace(/\D/g, "");

        if (valor.length > 11) {
            valor = valor.substring(0, 11);
        }

        valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
        valor = valor.replace(/(\d{3})(\d)/, "$1.$2");
        valor = valor.replace(/(\d{3})(\d{1,2})$/, "$1-$2");

        cpfInput.value = valor;
    });
</script>