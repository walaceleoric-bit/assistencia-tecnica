@model AssistenciaTecnica.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-4">
    <a class="back-button"
           asp-controller="Clientes"
           asp-action="Index">

        ← Voltar

    </a>
</div>


<form asp-action="Editar"
      method="post"
      class="form-card">

    <input type="hidden"
           asp-for="Id" />

    <input type="hidden"
           asp-for="DataCadastro" />


    <h2>Editar Cliente</h2>


    <label>Nome</label>
    <input asp-for="Nome"
           class="form-control" />

    <span asp-validation-for="Nome"
          class="text-danger"></span>


    <label>CPF</label>
    <input asp-for="Cpf"
           id="cpf"
           class="form-control"
           placeholder="000.000.000-00" />

    <span asp-validation-for="Cpf"
          class="text-danger"></span>


    <label>Telefone</label>
    <input asp-for="Telefone"
           class="form-control" />


    <label>Email</label>
    <input asp-for="Email"
           class="form-control" />


    <label>Endereço</label>
    <input asp-for="Endereco"
           class="form-control" />


    <label>Cidade</label>
    <input asp-for="Cidade"
           class="form-control" />


    <label>Observação</label>
    <textarea asp-for="Observacao"
              rows="4"
              class="form-control"></textarea>


    <button type="submit"
            class="btn-main mt-3">

        Salvar Alterações

    </button>

</form>