@model AssistenciaTecnica.Models.Cliente

@{
    ViewData["Title"] = "Detalhes do Cliente";
}

<div class="container mt-4">

    <a class="back-button"
           asp-controller="Clientes"
           asp-action="Index">

        ← Voltar

    </a>

</div>

<div class="form-card">

    <h2>👤 Detalhes do Cliente</h2>

    <div class="mt-4">

        <p><strong>Nome:</strong> @Model.Nome</p>

        <p><strong>CPF:</strong> @Model.Cpf</p>

        <p><strong>Telefone:</strong> @Model.Telefone</p>

        <p><strong>Email:</strong> @Model.Email</p>

        <p><strong>Endereço:</strong> @Model.Endereco</p>

        <p><strong>Cidade:</strong> @Model.Cidade</p>

        <p><strong>Observação:</strong> @Model.Observacao</p>

        <p>
            <strong>Cadastro:</strong>
            @Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")
        </p>

    </div>

</div>