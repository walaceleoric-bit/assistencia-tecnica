@model AssistenciaTecnica.Models.Empresa

@{
    ViewData["Title"] = "Editar Empresa";
}

<div class="container mt-4">
    <a class="back-button" asp-controller="Dono" asp-action="Index">
        ← Voltar
    </a>
</div>

<form asp-controller="Dono" asp-action="Editar" method="post" class="form-card">

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="DataCadastro" />

    <h2>Editar Empresa/Inquilino</h2>

    <label>Nome da empresa</label>
    <input asp-for="NomeEmpresa" class="form-control" />

    <label>Usuário de login</label>
    <input asp-for="Usuario" class="form-control" />

    <label>Senha</label>
    <input asp-for="Senha" class="form-control" />

    <label>WhatsApp</label>
    <input asp-for="WhatsApp" class="form-control" />

    <label class="mt-3">Status</label>
    <select asp-for="Ativo" class="form-control">
        <option value="true">Liberado</option>
        <option value="false">Bloqueado</option>
    </select>

    <button type="submit" class="btn-main mt-4">
        Salvar Alterações
    </button>

</form>