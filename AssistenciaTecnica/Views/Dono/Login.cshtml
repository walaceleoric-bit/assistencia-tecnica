@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Login Dono";
}

<div class="login-page">

    <a asp-controller="Home" asp-action="Landing">
        ← Voltar
    </a>

    <div class="login-card">

        <h1>Dono</h1>

        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Erro"]
            </div>
        }

        <form asp-controller="Dono" asp-action="Login" method="post">

            <label>Usuário</label>
            <input name="usuario" class="form-control" placeholder="Digite o usuário" />

            <label class="mt-3">Senha</label>
            <input type="password" name="senha" class="form-control" placeholder="Digite a senha" />

            <button type="submit" class="btn-main mt-4 w-100">
                Entrar
            </button>

        </form>

    </div>

</div>