@model AssistenciaTecnica.Models.Configuracao

@{
    ViewData["Title"] = "Configuração do Site";
}

<div class="container mt-4">
    <a class="back-button" asp-controller="Admin" asp-action="Index">
        ← Voltar para painel
    </a>
</div>

<div class="admin-config-page">

    <div class="admin-config-header">
        <h1>⚙ Configuração do Site</h1>
        <p>Controle a logo, textos, WhatsApp e imagens da página principal.</p>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    <form asp-action="Configuracao"
          method="post"
          enctype="multipart/form-data"
          class="config-panel">

        <input type="hidden" asp-for="Id" />

        <div class="config-section">
            <h3>🏢 Dados da Empresa</h3>

            <label>Nome da empresa</label>
            <input asp-for="NomeEmpresa" class="form-control" />

            <label>Subtítulo</label>
            <input asp-for="SubtituloEmpresa" class="form-control" />

            <label>WhatsApp principal</label>
            <input asp-for="WhatsApp"
                   class="form-control"
                   placeholder="Ex: 27999999999" />

            <small>Digite somente números com DDD.</small>

            <label>Cidades atendidas</label>
            <input asp-for="CidadesAtendidas" class="form-control" />


            <label>🔐 Senha do administrador</label>
            <input asp-for="SenhaAdm"
                   type="password"
                   class="form-control"
                   placeholder="Digite a nova senha do ADM" />

            <small>
                Altere aqui a senha usada no login do painel administrativo.
            </small>


            <label>Logo da empresa</label>
            <input type="file"
                   name="logo"
                   class="form-control"
                   accept="image/*" />

            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <div class="preview-box">
                    <p>Logo atual:</p>
                    <img src="@Model.LogoUrl" alt="Logo atual" />
                </div>
            }

        </div>


        <div class="config-section">
            <h3>🏠 Página Principal</h3>

            <label>Título principal</label>
            <input asp-for="TituloPrincipal" class="form-control" />

            <label>Texto principal</label>
            <textarea asp-for="TextoPrincipal"
                      class="form-control"
                      rows="4"></textarea>
        </div>


        <div class="config-section">
            <h3>🖼 Destaque 1</h3>

            <label>Título do destaque 1</label>
            <input asp-for="Destaque1Titulo" class="form-control" />

            <label>Texto do destaque 1</label>
            <textarea asp-for="Destaque1Texto"
                      class="form-control"
                      rows="3"></textarea>

            <label>Imagem do destaque 1</label>
            <input type="file"
                   name="destaque1"
                   class="form-control"
                   accept="image/*" />

            @if (!string.IsNullOrWhiteSpace(Model.Destaque1ImagemUrl))
            {
                <div class="preview-box large">
                    <p>Imagem atual:</p>
                    <img src="@Model.Destaque1ImagemUrl" alt="Destaque 1" />
                </div>
            }

        </div>


        <div class="config-section">
            <h3>🖼 Destaque 2</h3>

            <label>Título do destaque 2</label>
            <input asp-for="Destaque2Titulo" class="form-control" />

            <label>Texto do destaque 2</label>
            <textarea asp-for="Destaque2Texto"
                      class="form-control"
                      rows="3"></textarea>

            <label>Imagem do destaque 2</label>
            <input type="file"
                   name="destaque2"
                   class="form-control"
                   accept="image/*" />

            @if (!string.IsNullOrWhiteSpace(Model.Destaque2ImagemUrl))
            {
                <div class="preview-box large">
                    <p>Imagem atual:</p>
                    <img src="@Model.Destaque2ImagemUrl" alt="Destaque 2" />
                </div>
            }

        </div>


        <button type="submit" class="btn-main mt-4">
            Salvar Configurações
        </button>

    </form>

</div>