@model AssistenciaTecnica.Models.Configuracao

@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Contato";

    var config = Model ?? new AssistenciaTecnica.Models.Configuracao();

    var whatsappLimpo = config.WhatsApp?
        .Replace(" ", "")
        .Replace("-", "")
        .Replace("(", "")
        .Replace(")", "");

    var nomeEmpresa = string.IsNullOrWhiteSpace(config.NomeEmpresa)
        ? "Assistência Técnica"
        : config.NomeEmpresa;

    var cidadesAtendidas = string.IsNullOrWhiteSpace(config.CidadesAtendidas)
        ? "Serra, Vitória e região"
        : config.CidadesAtendidas;

    var mensagem = $"Olá, vim pelo site da {nomeEmpresa} e gostaria de solicitar um atendimento.";

    var linkWhatsApp = string.IsNullOrWhiteSpace(whatsappLimpo)
        ? "#"
        : $"https://wa.me/55{whatsappLimpo}?text={Uri.EscapeDataString(mensagem)}";
}

<section class="page-hero">
    <h1>Contato</h1>
    <p>Solicite atendimento rápido para @cidadesAtendidas.</p>
</section>

<section class="contact-area">
    <div class="form-card contact-card">

        <h2>@nomeEmpresa</h2>

        <p>
            Entre em contato para orçamento, visita técnica,
            compra ou venda de máquina de lavar.
        </p>

        @if (!string.IsNullOrWhiteSpace(config.WhatsApp))
        {
            <p>
                <b>WhatsApp:</b> @config.WhatsApp
            </p>
        }

        <p>
            <b>Região atendida:</b> @cidadesAtendidas
        </p>

        @if (!string.IsNullOrWhiteSpace(config.WhatsApp))
        {
            <a class="btn-main"
               href="@linkWhatsApp"
               target="_blank">
                Chamar no WhatsApp
            </a>
        }

    </div>
</section>