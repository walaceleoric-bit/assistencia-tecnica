@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Sistema para Assistência Técnica";
    ViewData["Description"] = "Sistema online para assistência técnica controlar clientes, ordens de serviço, estoque, produtos, vendas e relatórios em um só lugar.";
    ViewData["Keywords"] = "sistema para assistência técnica, ordem de serviço, controle de clientes, estoque, vendas, assistência técnica";
}

<section class="hero-tech">

    <div class="hero-content">

        <a asp-controller="Auth"
               asp-action="Login"
               class="btn-main">
            Login para acessar o sistema
        </a>

        <h1>
            Sistema para <br />
            Assistência Técnica
        </h1>

        <p>
            Controle clientes, ordens de serviço, estoque, produtos, vendas e relatórios em um só lugar.
        </p>

        <div class="feature-grid">

            <div class="feature-card">
                📋 Ordens de Serviço
            </div>

            <div class="feature-card">
                👥 Gestão de Clientes
            </div>

            <div class="feature-card">
                📦 Produtos e Vendas
            </div>

        </div>

    </div>

</section>