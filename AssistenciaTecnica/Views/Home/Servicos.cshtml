@{
    ViewData["Title"] = "Serviços";
}

<section class="servicos-hero-pro">

    <div class="container">
        <a class="back-button"
               asp-controller="Home"
               asp-action="Index">
            ← Voltar
        </a>
    </div>

    <div class="servicos-hero-content">
        <span>ASSISTÊNCIA ESPECIALIZADA</span>

        <h1>Serviços para seus eletrodomésticos</h1>

        <p>
            Manutenção, conserto, diagnóstico técnico, compra e venda
            de equipamentos com atendimento em Serra, Vitória e região.
        </p>
    </div>

</section>


<section class="servicos-grid-pro">

    <div class="servico-pro-card destaque">
        <div class="servico-pro-icon">🧺</div>
        <h3>Máquinas de lavar</h3>
        <p>
            Conserto, revisão, manutenção, troca de peças,
            diagnóstico de vazamentos, centrifugação e funcionamento.
        </p>
    </div>

    <div class="servico-pro-card">
        <div class="servico-pro-icon">📺</div>
        <h3>Televisores</h3>
        <p>
            Manutenção em TVs com falhas de imagem, som,
            tela escura, não liga ou problemas de funcionamento.
        </p>
    </div>

    <div class="servico-pro-card">
        <div class="servico-pro-icon">♨️</div>
        <h3>Micro-ondas</h3>
        <p>
            Análise e reparo de micro-ondas com defeitos elétricos,
            aquecimento, prato giratório e painel.
        </p>
    </div>

    <div class="servico-pro-card">
        <div class="servico-pro-icon">🔌</div>
        <h3>Outros eletrodomésticos</h3>
        <p>
            Atendimento para outros aparelhos elétricos domésticos,
            conforme avaliação técnica.
        </p>
    </div>

    <div class="servico-pro-card">
        <div class="servico-pro-icon">🛒</div>
        <h3>Compra e venda</h3>
        <p>
            Compra e venda de máquinas de lavar usadas,
            revisadas ou para avaliação.
        </p>
    </div>

    <div class="servico-pro-card chamada">
        <div class="servico-pro-icon">✅</div>
        <h3>Atendimento confiável</h3>
        <p>
            Serviço com transparência, diagnóstico claro
            e comunicação direta com o cliente.
        </p>
    </div>

</section>


<section class="servicos-processo">

    <div class="processo-title">
        <span>COMO FUNCIONA</span>
        <h2>Atendimento simples e rápido</h2>
    </div>

    <div class="processo-grid">

        <div>
            <strong>1</strong>
            <h3>Contato</h3>
            <p>O cliente chama pelo WhatsApp e informa o problema.</p>
        </div>

        <div>
            <strong>2</strong>
            <h3>Avaliação</h3>
            <p>O equipamento é analisado para identificar o defeito.</p>
        </div>

        <div>
            <strong>3</strong>
            <h3>Orçamento</h3>
            <p>O cliente recebe o valor antes da execução do serviço.</p>
        </div>

        <div>
            <strong>4</strong>
            <h3>Reparo</h3>
            <p>Após aprovação, o serviço é realizado com qualidade.</p>
        </div>

    </div>

</section>