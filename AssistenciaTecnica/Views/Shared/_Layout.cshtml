@using AssistenciaTecnica.Data
@inject AppDbContext Contexto
@inject IHttpContextAccessor ContextAccessor

@{
    var http = ContextAccessor.HttpContext;

    var empresaIdAdm = http?.Session.GetInt32("EMPRESA_ID") ?? 0;
    var empresaIdCliente = http?.Session.GetInt32("CLIENTE_EMPRESA_ID") ?? 0;

    var empresaId = empresaIdAdm > 0 ? empresaIdAdm : empresaIdCliente;

    var clienteLogado = http?.Session.GetString("CLIENTE_LOGADO") == "SIM";
    var admLogado = http?.Session.GetString("ADM_LOGADO") == "SIM";

    var estaNaLanding =
        ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
        ViewContext.RouteData.Values["action"]?.ToString() == "Landing";

    var logado = (clienteLogado || admLogado) && !estaNaLanding;

    var configLayout = Contexto.Configuracoes
        .FirstOrDefault(c => c.EmpresaId == empresaId);

    var nomeEmpresa = configLayout?.NomeEmpresa ?? "Empresa";
    var logoUrl = configLayout?.LogoUrl ?? "";
    var logoResolvedUrl = !string.IsNullOrWhiteSpace(logoUrl) && logoUrl.StartsWith("~")
        ? Url.Content(logoUrl)
        : logoUrl;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - @nomeEmpresa</title>

    <meta name="description"
          content="Assistência técnica especializada em celulares, notebooks e computadores." />

    <meta name="keywords"
          content="assistência técnica, conserto de celular, notebook, computador, troca de tela, formatação, suporte técnico" />

    <meta name="author"
          content="@nomeEmpresa" />

    <meta property="og:title"
          content="@ViewData["Title"] - @nomeEmpresa" />

    <meta property="og:description"
          content="Assistência técnica especializada em celulares, notebooks e computadores." />

    <meta property="og:type"
          content="website" />

    @if (!string.IsNullOrWhiteSpace(logoResolvedUrl))
    {
        <meta property="og:image" content="@logoResolvedUrl" />
    }

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @if (logado)
    {
        <header class="top-menu-pro">
            <div class="top-brand-center">
                @if (!string.IsNullOrWhiteSpace(logoResolvedUrl))
                {
                    <img src="@logoResolvedUrl" alt="@nomeEmpresa" />
                }
            </div>

            <nav class="top-nav-pro">
                <a asp-controller="Home" asp-action="Index">Início</a>

                @if (clienteLogado)
                {
                    <a asp-controller="AreaCliente" asp-action="Index">Serviços</a>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Servicos">Serviços</a>
                }

                <a asp-controller="Home" asp-action="Contato">Contato</a>

                <a class="admin-link-pro" asp-controller="Auth" asp-action="Sair">
                    Sair
                </a>
            </nav>
        </header>
    }

    <main>
        @RenderBody()
    </main>

    @if (logado)
    {
        <footer class="site-footer">
            © @DateTime.Now.Year - @nomeEmpresa
        </footer>
    }
    
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>