@using AssistenciaTecnica.Data
@inject AppDbContext Contexto

@{
    var configLayout = Contexto.Configuracoes.FirstOrDefault();
    var nomeEmpresa = configLayout?.NomeEmpresa ?? "Milton Cardoso";
    var logoUrl = configLayout?.LogoUrl ?? "";

    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionAtual = ViewContext.RouteData.Values["action"]?.ToString();

    var ehLanding = controllerAtual == "Home" && actionAtual == "Landing";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
        @(ehLanding ? "WLC Sistemas" : $"{ViewData["Title"]} - {nomeEmpresa}")
    </title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header class="top-menu-pro">

        <div class="top-brand-center">

            @if (ehLanding)
            {
                <div class="wlc-brand">
                    <h1>WLC Sistemas</h1>
                    <p>Soluções digitais para negócios inteligentes</p>
                </div>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(logoUrl))
                {
                    <img src="@logoUrl"
                         alt="@nomeEmpresa"
                         onerror="this.style.display='none'; document.getElementById('logoFallback').style.display='block';" />
                }

                <div id="logoFallback"
                     class="logo-fallback"
                     style="display:@(string.IsNullOrWhiteSpace(logoUrl) ? "block" : "none")">
                    ⚡
                </div>
            }

        </div>

        <nav class="top-nav-pro">

            @if (ehLanding)
            {
                <a class="admin-link-pro"
                       asp-controller="Auth"
                       asp-action="Login">
                    Login
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index">Início</a>
                <a asp-controller="Home" asp-action="Servicos">Serviços</a>
                <a asp-controller="Home" asp-action="Contato">Contato</a>

                <a class="admin-link-pro"
                       asp-controller="Auth"
                       asp-action="Login">
                    Login ADM
                </a>
            }

        </nav>

    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        © @DateTime.Now.Year - @(ehLanding ? "WLC Sistemas" : nomeEmpresa)
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>