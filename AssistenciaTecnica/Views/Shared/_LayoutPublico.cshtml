@using AssistenciaTecnica.Data
@using AssistenciaTecnica.Models
@inject AppDbContext Contexto
@inject IHttpContextAccessor ContextAccessor

@{
    var http = ContextAccessor.HttpContext;

    var empresaIdAdm = http?.Session.GetInt32("EMPRESA_ID") ?? 0;
    var empresaIdCliente = http?.Session.GetInt32("CLIENTE_EMPRESA_ID") ?? 0;

    var empresaId = empresaIdAdm > 0 ? empresaIdAdm : empresaIdCliente;

    var clienteLogado = http?.Session.GetString("CLIENTE_LOGADO") == "SIM";
    var admLogado = http?.Session.GetString("ADM_LOGADO") == "SIM";

    Configuracao? configLayout = null;

    try
    {
        // Se houver uma empresa identificada na sessão,
        // busca primeiro a configuração dessa empresa.
        if (empresaId > 0)
        {
            configLayout = Contexto.Configuracoes
                .FirstOrDefault(c => c.EmpresaId == empresaId);
        }

        // Se ninguém estiver logado ou não houver configuração
        // vinculada à sessão, utiliza a configuração pública.
        if (configLayout == null)
        {
            configLayout = Contexto.Configuracoes
                .OrderBy(c => c.Id)
                .FirstOrDefault();
        }
    }
    catch
    {
        configLayout = null;
    }

    var nomeEmpresa = configLayout?.NomeEmpresa ?? "Empresa";
    var logoUrl = configLayout?.LogoUrl ?? "";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - @nomeEmpresa</title>

    <meta name="description"
          content="Sistema para Assistência Técnica com controle de clientes, ordens de serviço, estoque, vendas e relatórios." />

    <meta name="keywords"
          content="assistência técnica, ordem de serviço, sistema para assistência técnica, controle de estoque, gestão de clientes, vendas" />

    <meta name="author" content="@nomeEmpresa" />

    <meta property="og:title"
          content="@ViewData["Title"] - @nomeEmpresa" />

    <meta property="og:description"
          content="Sistema para Assistência Técnica com controle de clientes, ordens de serviço, estoque, vendas e relatórios." />

    <meta property="og:type"
          content="website" />

    <meta property="og:image"
          content="https://assistencia-tecnica-qrwu.onrender.com/favicon.ico" />

    <link rel="icon"
          type="image/x-icon"
          href="~/favicon.ico" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="top-menu-pro">
        <div class="top-brand-center">
            @if (!string.IsNullOrWhiteSpace(logoUrl))
            {
                <img src="@logoUrl" alt="@nomeEmpresa" />
            }
        </div>

        <nav class="top-nav-pro">
            <a asp-controller="Home" asp-action="Index">
                Início
            </a>

            @if (clienteLogado)
            {
                <a asp-controller="AreaCliente" asp-action="Index">
                    Serviços
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Servicos">
                    Serviços
                </a>
            }

            <a asp-controller="Home" asp-action="Contato">
                Contato
            </a>

            @if (clienteLogado || admLogado)
            {
                <a class="admin-link-pro"
                   asp-controller="Auth"
                   asp-action="Sair">
                    Sair
                </a>
            }
            else
            {
                <a class="admin-link-pro"
                   asp-controller="Auth"
                   asp-action="Login">
                    Login
                </a>
            }
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        © @DateTime.Now.Year - @nomeEmpresa
    </footer>

</body>
</html>