@model AssistenciaTecnica.ViewModels.RelatorioViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Relatórios";
}

<div class="container mt-4 no-print d-flex justify-content-between align-items-center">

    <a class="back-button"
           asp-controller="Admin"
           asp-action="Index">
        ← Voltar para painel
    </a>

    <button onclick="window.print()" class="btn-pdf">

        <span class="pdf-icon">📄</span>

        <div class="pdf-text">
            <strong>Baixar PDF</strong>
            <small>Exportar relatório</small>
        </div>

    </button>

</div>

<div class="admin-hero relatorio-header">

    <h1>📊 Relatório Geral</h1>

    <p>
        Resumo completo de clientes, serviços, ordens e faturamento.
    </p>

</div>

<div class="dashboard-grid">

    <div class="dashboard-card">
        <h3>👥 Clientes</h3>
        <h2>@Model.TotalClientes</h2>
    </div>

    <div class="dashboard-card">
        <h3>🛠 Serviços</h3>
        <h2>@Model.TotalServicos</h2>
    </div>

    <div class="dashboard-card">
        <h3>📋 Ordens</h3>
        <h2>@Model.TotalOrdens</h2>
    </div>

    <div class="dashboard-card">
        <h3>⏳ Ordens Abertas</h3>
        <h2>@Model.OrdensAbertas</h2>
    </div>

    <div class="dashboard-card">
        <h3>✅ Finalizadas</h3>
        <h2>@Model.OrdensFinalizadas</h2>
    </div>

    <div class="dashboard-card">
        <h3>❌ Canceladas</h3>
        <h2>@Model.OrdensCanceladas</h2>
    </div>

    <div class="dashboard-card">
        <h3>💰 Faturado</h3>
        <h2>R$ @Model.FaturamentoFinalizado.ToString("N2")</h2>
    </div>

    <div class="dashboard-card">
        <h3>🧾 Ticket Médio</h3>
        <h2>R$ @Model.TicketMedio.ToString("N2")</h2>
    </div>

    <div class="dashboard-card">
        <h3>⌛ Valor em Aberto</h3>
        <h2>R$ @Model.FaturamentoEmAberto.ToString("N2")</h2>
    </div>

</div>

<div class="container mt-5 mb-5">

    <div class="form-card mb-5">
        <h3>📌 Status das Ordens</h3>
        <canvas id="graficoStatus"></canvas>
    </div>

    <div class="form-card mb-5">
        <h3>🛠 Serviços Mais Pedidos</h3>
        <canvas id="graficoServicos"></canvas>
    </div>

    <div class="form-card">
        <h3>💰 Faturamento Mensal</h3>
        <canvas id="graficoFaturamento"></canvas>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const statusLabels = @Html.Raw(JsonSerializer.Serialize(Model.StatusLabels));
    const statusValores = @Html.Raw(JsonSerializer.Serialize(Model.StatusValores));

    const servicosLabels = @Html.Raw(JsonSerializer.Serialize(Model.ServicosLabels));
    const servicosValores = @Html.Raw(JsonSerializer.Serialize(Model.ServicosValores));

    const mesesLabels = @Html.Raw(JsonSerializer.Serialize(Model.MesesLabels));
    const faturamentoValores = @Html.Raw(JsonSerializer.Serialize(Model.FaturamentoMesValores));

    new Chart(document.getElementById('graficoStatus'), {
    type: 'doughnut',
    data: {
    labels: statusLabels,
    datasets: [{
    data: statusValores
    }]
    }
    });

    new Chart(document.getElementById('graficoServicos'), {
    type: 'bar',
    data: {
    labels: servicosLabels,
    datasets: [{
    data: servicosValores
    }]
    }
    });

    new Chart(document.getElementById('graficoFaturamento'), {
    type: 'line',
    data: {
    labels: mesesLabels,
    datasets: [{
    data: faturamentoValores
    }]
    }
    });
</script>