@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <a asp-controller="Home"
           asp-action="Landing">
        ← Voltar
    </a>

    <div class="login-card">

        <h1>Login</h1>

        <form method="post">

            <label>Usuário</label>

            <input name="usuario"
                   class="form-control"
                   placeholder="Digite o usuário" />

            <label class="mt-3">Senha</label>

            <input type="password"
                   name="senha"
                   class="form-control"
                   placeholder="Digite a senha" />

            <button type="submit"
                    class="btn-main mt-4 w-100">
                Entrar
            </button>

        </form>

    </div>

</div>