@{
    Layout = "_LayoutPublico";
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <a asp-controller="Home"
           asp-action="Landing">
        ← Voltar
    </a>

    <div class="login-card">

        <div class="text-center mb-4">
            <h2 style="color:#12377c; font-weight:800; margin-bottom:5px;">
                Assistência Técnica
            </h2>

            <p style="color:#333; font-size:15px; margin-bottom:20px;">
                Acompanhe seus atendimentos de forma simples e segura.
            </p>
        </div>

        <h1>Login</h1>

        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Erro"]
            </div>
        }

        <form asp-controller="Auth"
              asp-action="Login"
              method="post">

            <label>Usuário</label>

            <input name="usuario"
                   class="form-control"
                   placeholder="Digite o usuário" />

            <label class="mt-3">Senha</label>

            <input type="password"
                   name="senha"
                   class="form-control"
                   placeholder="Digite a senha" />

            <button type="submit"
                    class="btn-main mt-4 w-100">
                Entrar
            </button>

        </form>

        <div class="mt-4 text-center"
             style="border-top:1px solid #e5e7eb; padding-top:20px;">

            <h5 style="color:#12377c; font-weight:700; margin-bottom:10px;">
                Área do Cliente
            </h5>

            <p style="font-size:15px; color:#333; line-height:1.6; margin-bottom:12px;">
                Consulte suas ordens de serviço, acompanhe o andamento dos seus equipamentos
                e visualize o histórico dos atendimentos realizados.
            </p>

            <p style="font-size:14px; color:#444; line-height:1.6; margin-bottom:0;">
                O acesso é exclusivo para clientes cadastrados pela assistência técnica.
                Caso ainda não possua usuário e senha, solicite seu cadastro diretamente com a equipe responsável.
            </p>
        </div>

    </div>

</div>