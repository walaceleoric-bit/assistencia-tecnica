@model List<AssistenciaTecnica.Models.OrdemServico>

@{
    ViewData["Title"] = "Ordens de Serviço";
}

<div class="container mt-4">

    <a class="back-button"
           asp-controller="Admin"
           asp-action="Index">

        ← Voltar para painel

    </a>

</div>


<div class="admin-hero">

    <h1>📋 Ordens de Serviço</h1>

    <p>
        Controle total dos atendimentos.
    </p>

</div>


<div class="container mb-5">

    <a class="btn-main"
           asp-action="Criar">

        + Nova Ordem

    </a>


    <div class="table-card mt-4">

        <table class="table">

            <thead>

                <tr>

                    <th>Nº</th>
                    <th>Cliente</th>
                    <th>Aparelho</th>
                    <th>Status</th>
                    <th>Valor</th>
                    <th>Ações</th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>#@item.Id</td>

                        <td>@item.Cliente?.Nome</td>

                        <td>@item.Aparelho</td>

                        <td>@item.Status</td>

                        <td>
                            R$ @item.Valor.ToString("N2")
                        </td>

                        <td>

                            <a class="btn btn-sm btn-info"
                                   asp-action="Detalhes"
                                   asp-route-id="@item.Id">

                                Ver

                            </a>


                            <a class="btn btn-sm btn-primary"
                                   asp-action="Editar"
                                   asp-route-id="@item.Id">

                                Editar

                            </a>


                            <a class="btn btn-sm btn-danger"
                                   asp-action="Excluir"
                                   asp-route-id="@item.Id">

                                Excluir

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>