@model AssistenciaTecnica.Models.OrdemServico

@{
    ViewData["Title"] = "Detalhes da Ordem";

    var telefoneLimpo = Model.Cliente?.Telefone?
        .Replace(" ", "")
        .Replace("-", "")
        .Replace("(", "")
        .Replace(")", "");

    var numeroWhatsApp = string.IsNullOrWhiteSpace(telefoneLimpo)
        ? ""
        : "55" + telefoneLimpo;

    var nomeEmpresa = ViewBag.EmpresaNome as string;

    if (string.IsNullOrWhiteSpace(nomeEmpresa))
    {
        nomeEmpresa = User?.Identity?.Name ?? "Minha Empresa";
    }

    var mensagemOrcamento =
        $"Olá {Model.Cliente?.Nome}, tudo bem? Sua ordem #{Model.Id} referente ao aparelho {Model.Aparelho} foi analisada. O valor do serviço ficou em R$ {Model.Valor:N2}. Podemos seguir com o reparo?";

    var mensagemPronto =
        $"Olá {Model.Cliente?.Nome}, tudo bem? Seu aparelho {Model.Aparelho}, referente à ordem #{Model.Id}, já está pronto. Pode entrar em contato para combinar a retirada/entrega.";

    var mensagemStatus =
        $"Olá {Model.Cliente?.Nome}, tudo bem? Passando para atualizar sua ordem #{Model.Id}. Status atual: {Model.Status}. Aparelho: {Model.Aparelho}.";

    var linkOrcamento = string.IsNullOrWhiteSpace(numeroWhatsApp)
        ? "#"
        : $"https://wa.me/{numeroWhatsApp}?text={Uri.EscapeDataString(mensagemOrcamento)}";

    var linkPronto = string.IsNullOrWhiteSpace(numeroWhatsApp)
        ? "#"
        : $"https://wa.me/{numeroWhatsApp}?text={Uri.EscapeDataString(mensagemPronto)}";

    var linkStatus = string.IsNullOrWhiteSpace(numeroWhatsApp)
        ? "#"
        : $"https://wa.me/{numeroWhatsApp}?text={Uri.EscapeDataString(mensagemStatus)}";
}

<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background: white !important;
        }

        .form-card {
            box-shadow: none !important;
            border: none !important;
        }
    }

    .pdf-button {
        background: linear-gradient(135deg, #0d6efd, #003b99);
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 14px;
        font-weight: 600;
        transition: .2s;
        text-decoration: none;
    }

        .pdf-button:hover {
            transform: translateY(-2px);
            opacity: .95;
            color: white;
        }
</style>

<div class="container mt-4 no-print">

    <div class="d-flex justify-content-between align-items-center">

        <a class="back-button" asp-action="Index">
            ← Voltar
        </a>

        <button onclick="window.print()" class="pdf-button">
            📄 Baixar PDF
        </button>

    </div>

</div>

<div class="form-card">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="mb-1">
                Ordem de Serviço #@Model.Id
            </h2>

            <p style="opacity:.7; margin:0;">
                Relatório completo da assistência técnica
            </p>

        </div>


    </div>

    <div class="whatsapp-actions no-print">

        <a class="btn-main" href="@linkOrcamento" target="_blank">
            Enviar orçamento
        </a>

        <a class="btn-main" href="@linkPronto" target="_blank">
            Avisar que está pronto
        </a>

        <a class="btn-outline-main" href="@linkStatus" target="_blank">
            Enviar status
        </a>

    </div>

    <hr />

    <p><b>Cliente:</b> @Model.Cliente?.Nome</p>

    <p><b>Telefone:</b> @Model.Cliente?.Telefone</p>

    <p><b>Serviço:</b> @Model.Servico?.Nome</p>

    <p><b>Aparelho:</b> @Model.Aparelho</p>

    @if (!string.IsNullOrWhiteSpace(Model.FotoUrl))
    {
        <img src="@Model.FotoUrl"
             style="max-width:100%; border-radius:18px; margin:20px 0;"
             alt="Foto do aparelho" />
    }

    <p><b>Marca/Modelo:</b> @Model.MarcaModelo</p>

    <p><b>Defeito relatado:</b> @Model.DefeitoRelatado</p>

    <p><b>Status atual:</b> @Model.Status</p>

    <p>
        <b>Valor do serviço:</b>

        <span style="
            background:#e8fff1;
            color:#008a43;
            padding:6px 12px;
            border-radius:10px;
            font-weight:700;
            ">
            R$ @Model.Valor.ToString("N2")
        </span>
    </p>

    <p><b>Observação técnica:</b> @Model.ObservacaoTecnica</p>

    <p>
        <b>Data de abertura:</b>
        @Model.DataAbertura.ToString("dd/MM/yyyy HH:mm")
    </p>

    @if (Model.DataFinalizacao != null)
    {
        <p>
            <b>Data de finalização:</b>
            @Model.DataFinalizacao.Value.ToString("dd/MM/yyyy HH:mm")
        </p>
    }

    <hr />

    <div style="text-align:center; opacity:.7; margin-top:40px;">
        Documento gerado automaticamente pelo sistema.
    </div>

</div>